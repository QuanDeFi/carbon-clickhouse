# Required provider Solana RPC URL. Do not use public mainnet-beta RPC.
SOLANA_RPC_URL=<provider-solana-mainnet-rpc-url>

# ClickHouse
DATABASE_URL=http://carbon:carbon@localhost:8123

# Jupiter bounded tutorial slots.
# Fill with known-good slots that contain Jupiter activity.
JUPITER_START_SLOT=<known-good-start-slot>
JUPITER_END_SLOT=<known-good-end-slot>

# Metrics
JUPITER_PROMETHEUS_METRICS_ADDR=0.0.0.0:9464
TOKEN_PROMETHEUS_METRICS_ADDR=0.0.0.0:9465

# ElevenLabs
ELEVENLABS_API_KEY=<elevenlabs-api-key>
ELEVENLABS_VOICE_ID=<elevenlabs-voice-id>
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_DISABLE_AUTO_VOICE_FALLBACK=false
ELEVENLABS_AUTO_WRITE_VOICE_ID=false

# Recording
RECORDER_BACKEND=ffmpeg_x11
DEMO_DISPLAY=:95
DEMO_SCREEN_SIZE=1920x1080
DEMO_FPS=30
DEMO_VNC_PORT=5903
DEMO_NOVNC_PORT=6083
DEMO_OUTPUT_DIR=demo-artifacts
DEMO_RECORDING_DIR=demo-artifacts/recordings
DEMO_AUDIO_DIR=demo-artifacts/audio
DEMO_FINAL_VIDEO=demo-artifacts/clickhouse-sink-tutorial.mp4

# OBS websocket, optional
OBS_WEBSOCKET_HOST=127.0.0.1
OBS_WEBSOCKET_PORT=4455
OBS_WEBSOCKET_PASSWORD=<optional-password>
