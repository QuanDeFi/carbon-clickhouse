{% extends "layout.njk" %}
{% import "macros.njk" as macros %}

{% block main %}
{% macro columnSpec(column, type) -%}
{% if clickHouseDdl.columnCodecs[column] -%}
ClickHouseColumnSpec::with_ddl_type("{{ column }}", r#"{{ type }}"#, r#"{{ type }} CODEC({{ clickHouseDdl.columnCodecs[column] }})"#)
{%- else -%}
ClickHouseColumnSpec::new("{{ column }}", r#"{{ type }}"#)
{%- endif %}
{%- endmacro %}

use carbon_core::{
    clickhouse::{
        clickhouse_column_names, clickhouse_create_table_sql, clickhouse_managed_tables,
        clickhouse_migration_operations, ClickHouseColumnSpec, ClickHouseManagedTable,
        ClickHouseTableOptions,
        rows::{
            ClickHouseEventLandingMetadata, ClickHouseRow, ClickHouseRowContext, ClickHouseTable,
            CLICKHOUSE_EVENT_COMMON_COLUMNS,
        },
    },
    instruction::InstructionMetadata,
};
#[allow(unused_imports)]
use carbon_core::clickhouse::rows::clickhouse_enum_variant;
{% if hasSharedHelpers %}
use super::types::*;
{% endif %}

#[derive(Debug, Clone, serde::Serialize)]
pub struct {{ event.name | pascalCase }}EventClickHouseRow {
    #[serde(flatten)]
    pub metadata: ClickHouseEventLandingMetadata,
{% for field in flatFields %}
    pub {{ field.column }}: {{ field.rowType }},
{% endfor %}
}

impl {{ event.name | pascalCase }}EventClickHouseRow {
    pub const FAMILY_NAME: &'static str = "{{ program.name | snakeCase }}_{{ event.name | snakeCase }}";
    pub const EVENT_TYPE: &'static str = "{{ event.name | snakeCase }}";
    pub const DEFAULT_TABLE_NAME: &'static str = "{{ program.name | snakeCase }}_{{ event.name | snakeCase }}_landing";
    pub const COMMON_COLUMNS: &'static [ClickHouseColumnSpec] = CLICKHOUSE_EVENT_COMMON_COLUMNS;
    pub const PAYLOAD_COLUMNS: &'static [ClickHouseColumnSpec] = &[
{% for field in flatFields %}
        {{ columnSpec(field.column, field.clickHouseColumnType) }},
{% endfor %}
    ];

    pub fn from_parts(
        source: crate::events::{{ macros.escapeRustKeyword(event.name | snakeCase) }}::{{ event.name | pascalCase }}Event,
        metadata: &InstructionMetadata,
        context: &ClickHouseRowContext,
    ) -> Self {
        let _ = &source;
        let event_seq = 0u32;

        Self {
            metadata: ClickHouseEventLandingMetadata::new(
                crate::PROGRAM_ID.as_ref(),
                crate::PROGRAM_ID.to_string(),
                Self::FAMILY_NAME,
                Self::EVENT_TYPE,
                event_seq,
                metadata,
                context,
            ),
{% for field in flatFields %}
            {{ field.column }}: {{ field.expr }},
{% endfor %}
        }
    }

    fn column_specs() -> Vec<ClickHouseColumnSpec> {
        let mut columns = Self::COMMON_COLUMNS.to_vec();
        columns.extend_from_slice(Self::PAYLOAD_COLUMNS);
        columns
    }

    fn table_options() -> ClickHouseTableOptions {
        ClickHouseTableOptions {
            on_cluster_clause: r#"{{ clickHouseDdl.onClusterClause }}"#,
            engine: r#"{{ clickHouseDdl.engine }}"#.to_string(),
{% if clickHouseDdl.createLocalTable %}
            local_engine: Some(r#"{{ clickHouseDdl.localEngine }}"#.to_string()),
{% else %}
            local_engine: None,
{% endif %}
            local_table_suffix: r#"{{ clickHouseDdl.localTableSuffix }}"#,
            partition_by: r#"{{ clickHouseDdl.partitionBy }}"#,
            order_by: r#"{{ clickHouseDdl.orderBy }}"#,
            ttl_clause: r#"{{ clickHouseDdl.ttlClause }}"#,
            settings_clause: r#"{{ clickHouseDdl.settingsClause }}"#,
        }
    }

    pub fn migration_operations(table_name: &str) -> Vec<String> {
        let columns = Self::column_specs();
        clickhouse_migration_operations(table_name, &columns, &Self::table_options())
    }

    pub fn managed_tables(table_name: &str) -> Vec<ClickHouseManagedTable> {
        let columns = Self::column_specs();
        clickhouse_managed_tables(table_name, &columns, &Self::table_options())
    }
}

impl ClickHouseTable for {{ event.name | pascalCase }}EventClickHouseRow {
    fn table() -> &'static str {
        Self::DEFAULT_TABLE_NAME
    }

    fn columns() -> Vec<&'static str> {
        let columns = Self::column_specs();
        clickhouse_column_names(&columns)
    }

    fn create_table_sql(table_name: &str) -> String {
        let columns = Self::column_specs();
        let options = Self::table_options();
        clickhouse_create_table_sql(
            table_name,
            &columns,
            &options.engine,
            options.local_engine.is_none(),
            &options,
        )
    }
}

impl ClickHouseRow for {{ event.name | pascalCase }}EventClickHouseRow {
    fn table_name(&self) -> &'static str {
        Self::table()
    }

    fn partition_key(&self) -> String {
        self.metadata.partition_key()
    }
}
{% endblock %}
