{% extends "layout.njk" %}
{% import "macros.njk" as macros %}

{% block main %}
use carbon_core::{
{% if isAccount %}
    account::{AccountMetadata, DecodedAccount},
{% else %}
    instruction::InstructionMetadata,
{% endif %}
    clickhouse::{
        ClickHouseColumnSpec,
        rows::{
{% if isAccount %}
            ClickHouseAccountLandingMetadata, CLICKHOUSE_ACCOUNT_COMMON_COLUMNS,
{% else %}
            ClickHouseInstructionLandingMetadata, CLICKHOUSE_INSTRUCTION_COMMON_COLUMNS,
{% endif %}
            ClickHouseRowContext,
        },
    },
};
#[allow(unused_imports)]
use carbon_core::clickhouse::rows::clickhouse_enum_variant;
{% if hasSharedHelpers %}
use super::types::*;
{% endif %}

#[derive(Debug, Clone, serde::Serialize)]
pub struct {{ entityName | pascalCase }}{% if isAccount %}Account{% else %}Instruction{% endif %}ClickHouseRow {
    #[serde(flatten)]
{% if isAccount %}
    pub metadata: ClickHouseAccountLandingMetadata,
{% else %}
    pub metadata: ClickHouseInstructionLandingMetadata,
{% endif %}
{% for field in flatFields %}
    pub {{ field.column }}: {{ field.rowType }},
{% endfor %}
}

impl {{ entityName | pascalCase }}{% if isAccount %}Account{% else %}Instruction{% endif %}ClickHouseRow {
    pub const FAMILY_NAME: &'static str = "{{ program.name | snakeCase }}_{{ entityName | snakeCase }}_{% if isAccount %}account{% else %}instruction{% endif %}";
{% if isAccount %}
    pub const ACCOUNT_TYPE: &'static str = "{{ entityName | snakeCase }}";
    pub const DEFAULT_TABLE_NAME: &'static str = "{{ program.name | snakeCase }}_{{ entityName | snakeCase }}_account_landing";
    pub const COMMON_COLUMNS: &'static [ClickHouseColumnSpec] = CLICKHOUSE_ACCOUNT_COMMON_COLUMNS;
{% else %}
    pub const INSTRUCTION_TYPE: &'static str = "{{ entityName | snakeCase }}";
    pub const DEFAULT_TABLE_NAME: &'static str = "{{ program.name | snakeCase }}_{{ entityName | snakeCase }}_instruction_landing";
    pub const COMMON_COLUMNS: &'static [ClickHouseColumnSpec] = CLICKHOUSE_INSTRUCTION_COMMON_COLUMNS;
{% endif %}
    pub const PAYLOAD_COLUMNS: &'static [ClickHouseColumnSpec] = &[
{% for field in flatFields %}
        {{ macros.clickHouseColumnSpec(field, clickHouseDdl) }},
{% endfor %}
    ];

{% if isAccount %}
    pub fn from_parts(
        source: crate::accounts::{{ macros.escapeRustKeyword(entityName | snakeCase) }}::{{ entityName | pascalCase }},
        decoded_account: &DecodedAccount<crate::accounts::{{ program.name | pascalCase }}Account>,
        metadata: &AccountMetadata,
        context: &ClickHouseRowContext,
    ) -> Self {
        let _ = &source;

        Self {
            metadata: ClickHouseAccountLandingMetadata::new(
                crate::PROGRAM_ID.as_ref(),
                crate::PROGRAM_ID.to_string(),
                Self::FAMILY_NAME,
                Self::ACCOUNT_TYPE,
                decoded_account,
                metadata,
                context,
            ),
{% for field in flatFields %}
            {{ field.column }}: {{ field.expr }},
{% endfor %}
        }
    }
{% else %}
    pub fn from_parts(
        source: crate::instructions::{{ macros.escapeRustKeyword(entityName | snakeCase) }}::{{ entityName | pascalCase }},
        metadata: &InstructionMetadata,
        context: &ClickHouseRowContext,
    ) -> Self {
        let _ = &source;

        Self {
            metadata: ClickHouseInstructionLandingMetadata::new(
                crate::PROGRAM_ID.as_ref(),
                crate::PROGRAM_ID.to_string(),
                Self::FAMILY_NAME,
                Self::INSTRUCTION_TYPE,
                metadata,
                context,
            ),
{% for field in flatFields %}
            {{ field.column }}: {{ field.expr }},
{% endfor %}
        }
    }
{% endif %}

}

{% if isAccount %}
carbon_core::impl_clickhouse_account_row!({{ entityName | pascalCase }}AccountClickHouseRow);
{% else %}
carbon_core::impl_clickhouse_instruction_row!({{ entityName | pascalCase }}InstructionClickHouseRow);
{% endif %}
{% endblock %}
