# ClickHouse HTTP endpoint. Use auth in the URL if your local instance needs it.
DATABASE_URL=http://carbon:carbon@localhost:8123

# RPC variant. Requires getProgramAccounts support. Use a provider URL from
# your local environment; the public mainnet-beta endpoint is not reliable for
# bounded account smoke tests.
RPC_URL=<rpc-url>

# Helius gPA v2 variant. Use with: --source helius-gpa-v2
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# At least one filter is required. The default canary target is a specific
# token account whose decoded mint is mainnet USDC.
TOKEN_ACCOUNT_OWNER=EKFXPqGVdNZmhSsp143XjqBqnEXsauPVWf3o4VeF9BVJ
# USDC mint, for reference or explicit mint-filter tests.
# TOKEN_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Optional Helius gPA v2 controls.
# HELIUS_GPA_V2_CHANGED_SINCE_SLOT=
# HELIUS_GPA_V2_PAGE_LIMIT=1000

# Optional ClickHouse async-wait insert mode. Sync is the default.
# CLICKHOUSE_ASYNC_INSERT=false
# CLICKHOUSE_ASYNC_INSERT_BUSY_TIMEOUT_MS=1000
# CLICKHOUSE_ASYNC_INSERT_MAX_DATA_SIZE=
# CLICKHOUSE_ASYNC_INSERT_MAX_QUERY_NUMBER=
# CLICKHOUSE_ASYNC_INSERT_DEDUPLICATE=true

# Carbon Prometheus metrics endpoint.
PROMETHEUS_METRICS_ADDR=0.0.0.0:9464

LOG_LEVEL=info
