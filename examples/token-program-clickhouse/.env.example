# ClickHouse HTTP endpoint. Use auth in the URL if your local instance needs it.
DATABASE_URL=http://carbon:carbon@localhost:8123

# RPC endpoint. The example uses getMultipleAccounts for four fixed USDC
# accounts. Use a provider URL from your local environment; the public
# mainnet-beta endpoint is not reliable for account smoke tests.
RPC_URL=<rpc-url>

# Optional ClickHouse async-wait insert mode. Sync is the default.
# CLICKHOUSE_ASYNC_INSERT=false

LOG_LEVEL=info
