# ClickHouse HTTP endpoint. Use auth in the URL if your local instance needs it.
DATABASE_URL=http://carbon:carbon@localhost:8123

# RPC endpoint. The example uses getMultipleAccounts for four fixed USDC
# accounts, then tails finalized blocks through the RPC block crawler. Use a
# provider URL from your local environment; the public mainnet-beta endpoint is
# not reliable for account and block-crawler smoke tests.
RPC_URL=<rpc-url>

# Optional ClickHouse async-wait insert mode. Sync is the default.
# CLICKHOUSE_ASYNC_INSERT=false

# Carbon Prometheus metrics endpoint. Defaults to 9465 so Jupiter can use 9464.
PROMETHEUS_METRICS_ADDR=0.0.0.0:9465

LOG_LEVEL=info
